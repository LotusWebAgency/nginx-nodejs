--- a/static/ngx_http_brotli_static_module.c
+++ b/static/ngx_http_brotli_static_module.c
@@ -271,3 +271,6 @@
+  /* Match gzip_static: ranges address bytes of the encoded representation. */
+  req->allow_ranges = 1;
+
   /* Setup response body. */
   buf = ngx_pcalloc(req->pool, sizeof(ngx_buf_t));
   if (buf == NULL) return NGX_HTTP_INTERNAL_SERVER_ERROR;
--- a/filter/ngx_http_brotli_filter_module.c
+++ b/filter/ngx_http_brotli_filter_module.c
@@ -262,1 +262,10 @@
+  /* Nginx replaces an unsatisfiable static range with an identity error body,
+   * but retains the original br/gzip encoding header on the second pass. */
+  if (r->upstream == NULL &&
+      r->headers_out.status == NGX_HTTP_RANGE_NOT_SATISFIABLE &&
+      r->headers_out.content_encoding) {
+    r->headers_out.content_encoding->hash = 0;
+    r->headers_out.content_encoding = NULL;
+  }
+
   conf = ngx_http_get_module_loc_conf(r, ngx_http_brotli_filter_module);
